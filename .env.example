# ==============================================================================
# Vyapaar AI - Environment Variables (100% Free-Tier Stack)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
FRONTEND_PORT=3000

# Free-Tier AI Engine (Google Gemini Free Tier)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_free_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Database Settings (Defaults to local SQLite for instant zero-config setup)
# For MySQL: mysql+pymysql://user:password@localhost:3306/vyapaar_ai
DATABASE_URL=sqlite:///./vyapaar_ai.db

# Edge-TTS Free Neural Voice Settings (No API Key Required)
# Available Indian voices: hi-IN-MadhurNeural (Male Hindi), hi-IN-SwaraNeural (Female Hindi),
# en-IN-PrabhatNeural (Male Indian English), en-IN-NeerjaNeural (Female Indian English)
DEFAULT_TTS_VOICE=hi-IN-MadhurNeural

# Security & Sessions
SECRET_KEY=vyapaar_ai_super_secret_hackathon_key_2026_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
